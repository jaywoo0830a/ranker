# Copy to .env (gitignored) and fill in real values:
#   cp .env.example .env
# Then load before running:
#   set -a; source .env; set +a
#   ranker examples/prod.yaml
#
# Required only when the manifest carries a 'proxy:' block. For dev
# manifests without a proxy block these vars can be left unset.

# ProxyEmpire account stem — the 'm_xxxxxxxxxx' prefix shown in the
# Proxy Manager. Note: the country/sid/ttl suffixes are composed at
# runtime, do NOT include them here.
PROXYEMPIRE_USERNAME=m_xxxxxxxxxx

# ProxyEmpire account password.
PROXYEMPIRE_PASSWORD=xxxxxxxxxx
