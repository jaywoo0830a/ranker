# Copy to .env (gitignored) and fill in real values:
#   cp .env.example .env
# Then load before running:
#   set -a; source .env; set +a
#   ranker examples/prod.yaml
#
# Required only when the manifest carries a 'proxy:' block. For dev
# manifests without a proxy block these vars can be left unset.

# ProxyEmpire account stem — the 'm_xxxxxxxxxx' prefix shown in the
# Proxy Manager. Note: the country/sid/ttl suffixes are composed at
# runtime, do NOT include them here.
PROXYEMPIRE_USERNAME=m_xxxxxxxxxx

# ProxyEmpire account password.
PROXYEMPIRE_PASSWORD=xxxxxxxxxx

# --- Docker Compose port bindings (optional) ---
# 호스트의 다른 프로세스가 기본 포트를 점유 중이면 여기서 바꿔주세요.
# 컨테이너 내부 포트는 그대로(8000/5173/80) 유지되고 호스트 쪽만 바뀝니다.

# Dev: API uvicorn이 노출되는 호스트 포트 (default 8000)
API_PORT=8000

# Dev: Vite dev server가 노출되는 호스트 포트 (default 5173)
WEBAPP_PORT=5173

# Prod: webapp nginx가 바인딩되는 호스트 포트 (default 8080)
# 호스트 nginx에서 proxy_pass로 연결할 포트.
WEBAPP_PROD_PORT=8080

# Prod: webapp nginx가 바인딩되는 호스트 인터페이스 (default 127.0.0.1).
# 호스트 nginx 없이 직접 외부에 노출하려면 0.0.0.0 으로 바꾸세요.
WEBAPP_PROD_BIND=127.0.0.1
